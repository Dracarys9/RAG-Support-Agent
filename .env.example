# Copy this file to .env only if local configuration is needed.
# Never commit .env or real credentials.

# Keep local mode for tests and offline use.
# Set MODEL_PROVIDER=llm only when you want model-generated answers.
MODEL_PROVIDER=llm
MODEL_NAME=gemini-3.7-flash

# Required only when MODEL_PROVIDER=llm.
OPENAI_API_KEY=
OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/